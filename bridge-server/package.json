{
  "name": "foundry-rest-bridge-server",
  "version": "1.0.0",
  "description": "Node.js bridge server for FoundryVTT Local REST API module",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:contracts": "NODE_OPTIONS=--experimental-vm-modules jest tests/contracts",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest tests/e2e"
  },
  "keywords": [
    "foundry",
    "foundryvtt",
    "rest-api",
    "bridge",
    "socket.io",
    "express"
  ],
  "author": "FoundryVTT Local REST API",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io-client": "^4.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "node-fetch": "^3.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.0",
    "ajv": "^8.20.0",
    "nock": "^13.4.0",
    "socket.io": "^4.7.5"
  }
}
