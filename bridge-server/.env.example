# FoundryVTT connection settings
FOUNDRY_URL=http://localhost:30000
API_KEY=your_foundry_api_key_here

# FoundryVTT authentication (required for authenticated connection)
FOUNDRY_USERNAME=your_foundry_username
# Optional: the world user's 16-character document id; skips the name lookup
# FOUNDRY_USER_ID=
FOUNDRY_PASSWORD=your_foundry_password
FOUNDRY_WORLD_ID=your_world_id

# Bridge server settings
API_PORT=3030
REQUEST_TIMEOUT=10000

# Security settings
CORS_ORIGIN=*
LOG_LEVEL=info

# Optional: Override default settings
# FOUNDRY_NAMESPACE=module.foundryvtt-local-rest-api
# MAX_RETRIES=3
# RECONNECT_DELAY=1000