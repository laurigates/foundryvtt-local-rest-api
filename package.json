{
  "name": "foundryvtt-local-rest-api",
  "version": "2.0.0",
  "description": "A secure local REST API for FoundryVTT v13 with enhanced security, permission validation, and Query System support",
  "main": "scripts/rest-api.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "npm test && cd bridge-server && npm test",
    "test:production": "node test-production.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/foundryvtt-local-rest-api.git"
  },
  "keywords": [
    "foundry",
    "foundryvtt",
    "rest-api",
    "module",
    "tabletop",
    "rpg"
  ],
  "author": "Lauri Gates",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yourusername/foundryvtt-local-rest-api/issues"
  },
  "homepage": "https://github.com/yourusername/foundryvtt-local-rest-api#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@testing-library/dom": "^9.3.0",
    "babel-jest": "^30.0.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "socket.io-mock": "^1.3.0"
  }
}
